{
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git tag*)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm ci)",
      "Bash(find .claude*)",
      "Bash(head*)",
      "Bash(grep*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[SESSION START] Read these files before any work: PROJECT_STATE.md, CONVENTIONS.md, BACKLOG.md, DECISIONS.md. The memory-protocol skill provides the full checklist.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -q 'git commit'; then if [ -f package.json ]; then npm run lint 2>&1 && npm run typecheck 2>&1 || (echo '[HOOK BLOCKED] Lint or typecheck failed. Fix before committing.' && exit 1); else echo '[HOOK] No package.json found — skipping lint/typecheck.'; fi; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/CLAUDE-Blueprint/.claude/hooks/post-agent-eval.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/CLAUDE-Blueprint/.claude/hooks/stop-check.sh"
          }
        ]
      }
    ]
  }
}
